# Variables para docker compose. Copia a .env y completa.
# Genera secretos con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Primer administrador (se crea al arrancar si no existe)
ADMIN_EMAIL=admin@tuclinica.com
ADMIN_PASSWORD=

# Base de datos del contenedor
DB_PASSWORD=cambia_esto

# Correo para confirmaciones y recordatorios (Gmail con contraseña de aplicación)
EMAIL_USER=
EMAIL_APP_PASSWORD=

# true = cuentas de demo con contraseña pública Demo1234! (solo para probar)
SEED_DEMO=false
PORT=3000
